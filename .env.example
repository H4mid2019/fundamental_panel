# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
# Optional. When absent the AI brief falls back to a deterministic local brief.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# ── Data providers ─────────────────────────────────────────────────────────────
# All optional. When a provider key is absent, that provider falls back to
# deterministic fixtures so the app (and CI/E2E) runs without external accounts.
FMP_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=
# Finnhub powers the news feature (free tier: 60 calls/min). https://finnhub.io/register
FINNHUB_API_KEY=

# ── Cache ──────────────────────────────────────────────────────────────────────
# Priority: REDIS_URL > Upstash > in-memory LRU. Set ONE of these (or none).
#
# Self-hosted Redis (native protocol). The DB index is the URL path, e.g.
# redis://127.0.0.1:6379/3 selects DB 3 (default DB 0). With a password:
# redis://:password@127.0.0.1:6379/3
REDIS_URL=
#
# Docker Compose only: the compose file builds REDIS_URL as
# redis://redis:6379/${REDIS_DB} — set the DB index here (0-15, default 0).
REDIS_DB=
#
# Or Upstash hosted Redis (HTTP REST). Do NOT point these at a local Redis —
# they require Upstash's REST endpoint, not the native :6379 protocol.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── HedgeScope (/hedge) ────────────────────────────────────────────────────────
# The options-monitoring surface. Non-secret settings (ticker universe, scan
# schedule, thresholds) live in `hedge.config.yaml`, not here.
#
# Path to the SQLite file holding the accumulated IV history. Unlike everything
# else in this app, this is REAL STORAGE, not a cache — see the README warning.
# Docker Compose overrides this to /data/hedge.db on the `hedge-data` volume.
HEDGE_DB_PATH=./data/hedge.db
#
# Override the location of hedge.config.yaml (Compose mounts it at /app).
HEDGE_CONFIG_PATH=
#
# Shared secret for `POST /api/hedge/scan` (sent as `x-hedge-secret`). When
# unset, the manual-scan endpoint is DISABLED rather than left unauthenticated.
HEDGE_SCAN_SECRET=
#
# Which role this container plays. "all" (default) serves requests and runs the
# scan cron. Set the web container to "web" and add a second container with
# "scanner" to move scans off the request-serving process. Only one process may
# run the scheduler; a Redis lock enforces it if you get this wrong.
HEDGE_ROLE=all
#
# Optional Slack incoming webhook for alerts. Skipped silently when unset.
SLACK_WEBHOOK_URL=

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to force all providers to serve deterministic fixtures (used by E2E,
# handy for offline demos). Leave blank for live data.
USE_FIXTURES=
